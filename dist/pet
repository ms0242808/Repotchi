'use strict';

const os = require('os');
const path = require('path');

function homeDir() {
  if (process.env.REPOTCHI_HOME) return path.resolve(process.env.REPOTCHI_HOME);
  const base = process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state');
