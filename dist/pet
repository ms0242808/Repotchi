  const active = days.filter((d) => d.xp > 0).length;
  const total = days.reduce((n, d) => n + d.xp, 0);
  c.row(`  ${p.dim(`${active} active days, ${total} xp, best day ${Math.max(0, ...days.map((d) => d.xp))} xp`)}`);
