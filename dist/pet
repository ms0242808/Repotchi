      this.timer = null;
      this.onChange();
    }, DEBOUNCE_MS);
  }

  get active() {
    return this.handles.size > 0;
  }

  close() {
    clearTimeout(this.timer);
    for (const dir of [...this.handles.keys()]) this.drop(dir);
  }
}

module.exports = { RepoWatcher, gitDirOf, DEBOUNCE_MS };
