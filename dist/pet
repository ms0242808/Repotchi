      `${p.gold('this deletes')} ${p.snow(state.name)}${p.gold(',')} `
      + `${p.dim(`level ${snap.level} ${snap.stage.name}, ${state.totals.commit} commits eaten.`)}\n`
      + `${p.dim('re-run with')} --yes ${p.dim('to confirm.')}\n`,
