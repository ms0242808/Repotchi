      const current = prefs[name] || spec.values[0];
      process.stdout.write(`  ${p.snow(a.pad(name, 8))} ${p.gold(a.pad(current, 10))} ${p.dim(spec.describe)}\n`);
      process.stdout.write(`  ${' '.repeat(8)} ${p.dim(`options: ${spec.values.join(', ')}`)}\n`);
    }
    return;
  }

